<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy">

    <!-- ===== TOOLBAR ===== -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/toolbar_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">
            <TextView
                android:id="@+id/menu_button"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/text_primary"
                android:textSize="26sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="HTTP"
                android:textColor="@color/warm_amber"
                android:textSize="32sp"
                android:fontFamily="sans" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Custom"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:fontFamily="sans" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView
                android:id="@+id/more_button"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⋮"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@color/navy">
            <TextView
                android:id="@+id/tab_main"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Main"
                android:textColor="@color/blue_active"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/tab_active" />
            <TextView
                android:id="@+id/tab_log"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Log"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== CONTENT (ScrollView) ===== -->
    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Traffic Card -->
            <LinearLayout
                android:id="@+id/traffic_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout 
                        android:layout_width="0dp" 
                        android:layout_height="wrap_content" 
                        android:layout_weight="1" 
                        android:orientation="vertical">
                        <TextView 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:text="↓  Download" 
                            android:textColor="@color/download_blue" 
                            android:textSize="16sp" 
                            android:textStyle="bold" />
                        <TextView 
                            android:id="@+id/download_value" 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:text="0 B/s" 
                            android:textColor="@color/download_blue" 
                            android:textSize="28sp" 
                            android:textStyle="bold" />
                        <TextView 
                            android:id="@+id/download_peak" 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:text="Peak 0 B/s" 
                            android:textColor="@color/download_blue" 
                            android:textSize="14sp" />
                    </LinearLayout>
                    <LinearLayout 
                        android:layout_width="0dp" 
                        android:layout_height="wrap_content" 
                        android:layout_weight="1" 
                        android:gravity="end" 
                        android:orientation="vertical">
                        <TextView 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:text="↑  Upload" 
                            android:textColor="@color/upload_pink" 
                            android:textSize="16sp" 
                            android:textStyle="bold" />
                        <TextView 
                            android:id="@+id/upload_value" 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:text="0 B/s" 
                            android:textColor="@color/upload_pink" 
                            android:textSize="28sp" 
                            android:textStyle="bold" />
                        <TextView 
                            android:id="@+id/upload_peak" 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:text="Peak 0 B/s" 
                            android:textColor="@color/upload_pink" 
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="16dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="5dp"
                    android:text="●  Idle"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View 
                    android:layout_width="match_parent" 
                    android:layout_height="1dp" 
                    android:layout_marginTop="14dp" 
                    android:background="@color/stroke_dark" />

                <TextView 
                    android:id="@+id/ip_text" 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:layout_gravity="end" 
                    android:layout_marginTop="8dp" 
                    android:text="◉  10.164.226.1" 
                    android:textColor="@color/text_primary" 
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Main connection -->
            <LinearLayout 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginTop="20dp" 
                android:gravity="center_vertical" 
                android:orientation="horizontal">
                <TextView 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:text="Main connection" 
                    android:textColor="@color/text_primary" 
                    android:textSize="22sp" 
                    android:textStyle="bold" />
                <View 
                    android:layout_width="0dp" 
                    android:layout_height="1dp" 
                    android:layout_marginStart="10dp" 
                    android:layout_weight="1" 
                    android:background="@color/stroke_dark" />
                <TextView 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:layout_marginStart="8dp" 
                    android:text="⌃" 
                    android:textColor="@color/text_primary" 
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Button Row 1 -->
            <LinearLayout 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginTop="14dp" 
                android:orientation="horizontal">
                <TextView 
                    android:id="@+id/profiles_button" 
                    android:layout_width="0dp" 
                    android:layout_height="48dp" 
                    android:layout_marginEnd="4dp" 
                    android:layout_weight="1" 
                    android:background="@drawable/bg_outline_button" 
                    android:gravity="center" 
                    android:text="Profiles" 
                    android:textColor="@color/text_primary" 
                    android:textSize="16sp" />
                <TextView 
                    android:id="@+id/ssh_button" 
                    android:layout_width="0dp" 
                    android:layout_height="48dp" 
                    android:layout_marginStart="4dp" 
                    android:layout_marginEnd="4dp" 
                    android:layout_weight="0.72" 
                    android:background="@drawable/bg_outline_button" 
                    android:gravity="center" 
                    android:text="SSH" 
                    android:textColor="@color/text_primary" 
                    android:textSize="16sp" />
                <TextView 
                    android:id="@+id/v2ray_button" 
                    android:layout_width="0dp" 
                    android:layout_height="48dp" 
                    android:layout_marginStart="4dp" 
                    android:layout_marginEnd="4dp" 
                    android:layout_weight="0.95" 
                    android:background="@drawable/bg_outline_button" 
                    android:gravity="center" 
                    android:text="V2Ray" 
                    android:textColor="@color/text_primary" 
                    android:textSize="16sp" />
                <TextView 
                    android:id="@+id/psiphon_button" 
                    android:layout_width="0dp" 
                    android:layout_height="48dp" 
                    android:layout_marginStart="4dp" 
                    android:layout_weight="1.05" 
                    android:background="@drawable/bg_outline_button" 
                    android:gravity="center" 
                    android:text="Psiphon" 
                    android:textColor="@color/text_primary" 
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Button Row 2 -->
            <LinearLayout 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginTop="10dp" 
                android:orientation="horizontal">
                <TextView 
                    android:id="@+id/openvpn_button" 
                    android:layout_width="0dp" 
                    android:layout_height="48dp" 
                    android:layout_marginEnd="4dp" 
                    android:layout_weight="1.15" 
                    android:background="@drawable/bg_outline_button" 
                    android:gravity="center" 
                    android:text="OpenVPN" 
                    android:textColor="@color/text_primary" 
                    android:textSize="16sp" />
                <TextView 
                    android:id="@+id/udp_button" 
                    android:layout_width="0dp" 
                    android:layout_height="48dp" 
                    android:layout_marginStart="4dp" 
                    android:layout_weight="1.35" 
                    android:background="@drawable/bg_outline_button" 
                    android:gravity="center" 
                    android:text="UDP Custom" 
                    android:textColor="@color/text_primary" 
                    android:textSize="16sp" />
                <View 
                    android:layout_width="0dp" 
                    android:layout_height="1dp" 
                    android:layout_weight="0.5" />
            </LinearLayout>

            <!-- Profiles Panel -->
            <LinearLayout
                android:id="@+id/profiles_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="16dp"
                android:background="@drawable/bg_card">

                <TextView 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:text="Proxy profile" 
                    android:textColor="@color/text_primary" 
                    android:textSize="18sp" 
                    android:textStyle="bold" />

                <EditText 
                    android:id="@+id/name_input" 
                    android:layout_width="match_parent" 
                    android:layout_height="44dp" 
                    android:layout_marginTop="8dp" 
                    android:hint="Profile name" 
                    android:textColor="@color/text_primary" 
                    android:textColorHint="@color/text_muted" 
                    android:singleLine="true" />

                <EditText 
                    android:id="@+id/host_input" 
                    android:layout_width="match_parent" 
                    android:layout_height="44dp" 
                    android:layout_marginTop="4dp" 
                    android:hint="Host / IP" 
                    android:textColor="@color/text_primary" 
                    android:textColorHint="@color/text_muted" 
                    android:singleLine="true" />

                <EditText 
                    android:id="@+id/port_input" 
                    android:layout_width="match_parent" 
                    android:layout_height="44dp" 
                    android:layout_marginTop="4dp" 
                    android:hint="Port" 
                    android:inputType="number" 
                    android:textColor="@color/text_primary" 
                    android:textColorHint="@color/text_muted" 
                    android:singleLine="true" />

                <Button 
                    android:id="@+id/save_button" 
                    android:layout_width="match_parent" 
                    android:layout_height="44dp" 
                    android:layout_marginTop="10dp" 
                    android:text="Save profile" 
                    android:textColor="@color/navy" 
                    android:backgroundTint="@color/blue_active" />

                <Button 
                    android:id="@+id/test_button" 
                    android:layout_width="match_parent" 
                    android:layout_height="44dp" 
                    android:layout_marginTop="6dp" 
                    android:text="Test HTTP Proxy" 
                    android:textColor="@color/text_primary" 
                    android:backgroundTint="@color/surface_alt" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== LOG PANEL ===== -->
    <TextView
        android:id="@+id/log_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="20dp"
        android:text="No connection log yet.\n\nSave a profile and test your HTTP Proxy to see events here."
        android:textColor="@color/text_muted"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== PLAY BUTTON ===== -->
    <TextView
        android:id="@+id/play_button"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_play_button"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp" />

    <!-- ===== BOTTOM NAVIGATION ===== -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:gravity="center"
        android:background="@color/toolbar_dark"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView 
            android:id="@+id/nav_home" 
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center" 
            android:text="⌂\nHome" 
            android:textColor="@color/blue_active" 
            android:textSize="14sp" 
            android:textStyle="bold" />

        <TextView 
            android:id="@+id/nav_profiles" 
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center" 
            android:text="☷\nProfiles" 
            android:textColor="@color/text_primary" 
            android:textSize="14sp" />

        <TextView 
            android:id="@+id/nav_settings" 
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center" 
            android:text="⚙\nSettings" 
            android:textColor="@color/text_primary" 
            android:textSize="14sp" />

        <TextView 
            android:id="@+id/nav_guide" 
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center" 
            android:text="▤\nGuide" 
            android:textColor="@color/text_primary" 
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>